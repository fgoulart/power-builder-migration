{
  "name": "power-builder-migration",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo com Angular (frontend) e Python/FastAPI (backend)",
  "workspaces": [
    "apps/frontend"
  ],
  "scripts": {
    "frontend": "npm run start --workspace=apps/frontend",
    "frontend:build": "npm run build --workspace=apps/frontend",
    "frontend:test": "npm run test --workspace=apps/frontend",
    "backend": "cd apps/backend && uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "backend:install": "cd apps/backend && python3 -m venv .venv && . .venv/bin/activate && pip install -r requirements.txt",
    "db:migrate": "cd apps/backend && . .venv/bin/activate && alembic upgrade head",
    "db:revision": "cd apps/backend && . .venv/bin/activate && alembic revision --autogenerate -m",
    "dev": "concurrently -n frontend,backend -c blue,green \"npm run frontend\" \"npm run backend\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
