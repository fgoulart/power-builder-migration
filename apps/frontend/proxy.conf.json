{
  "/api": {
    "target": "http://localhost:8080",
    "secure": false,
    "changeOrigin": true,
    "xfwd": true,
    "ws": true,
    "logLevel": "info",
    "timeout": 120000,
    "proxyTimeout": 120000,
    "followRedirects": true,
    "pathRewrite": {
      "^/api": "/api"
    },
    "headers": {
      "Connection": "keep-alive",
      "X-Forwarded-Prefix": "/api",
      "X-Forwarded-Host": "localhost:8080",
      "X-Forwarded-Proto": "http"
    }
  },
  "/launcher": {
    "target": "http://localhost:8080",
    "secure": false,
    "changeOrigin": true,
    "xfwd": true,
    "ws": false,
    "logLevel": "info",
    "timeout": 120000,
    "proxyTimeout": 120000,
    "followRedirects": true,
    "pathRewrite": {
      "^/launcher": "/launcher"
    },
    "headers": {
      "Connection": "keep-alive",
      "X-Forwarded-Prefix": "/launcher",
      "X-Forwarded-Host": "localhost:8080",
      "X-Forwarded-Proto": "http"
    }
  }
}
