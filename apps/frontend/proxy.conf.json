[
  {
    "context": ["/api"],
    "target": "http://localhost:8080",
    "secure": false,
    "changeOrigin": true,
    "ws": true,
    "xfwd": true,
    "logLevel": "info",
    "timeout": 120000,
    "proxyTimeout": 120000,
    "followRedirects": true,
    "headers": {
      "Connection": "keep-alive",
      "X-Forwarded-Prefix": "/api",
      "X-Forwarded-Host": "localhost:8080",
      "X-Forwarded-Port": "8080",
      "X-Forwarded-Proto": "http"
    }
  },
  {
    "context": ["/launcher"],
    "target": "http://localhost:8080",
    "secure": false,
    "changeOrigin": true,
    "ws": false,
    "xfwd": true,
    "logLevel": "info",
    "timeout": 120000,
    "proxyTimeout": 120000,
    "followRedirects": true,
    "headers": {
      "Connection": "keep-alive",
      "X-Forwarded-Prefix": "/launcher",
      "X-Forwarded-Host": "localhost:8080",
      "X-Forwarded-Port": "8080",
      "X-Forwarded-Proto": "http"
    }
  }
]
