[
  {
    "context": ["/api"],
    "target": "http://localhost:8080",
    "secure": false,
    "changeOrigin": true,
    "xfwd": true,
    "ws": true,
    "logLevel": "info",
    "timeout": 120000,
    "proxyTimeout": 120000,
    "followRedirects": true,
    "headers": {
      "Connection": "keep-alive"
    }
  }
]
